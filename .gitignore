# generate all related files for gitignore

# Ignore node_modules
node_modules/
# Ignore build output
dist/
build/
# Ignore logs
logs/
*.log
# Ignore environment variables
.env
# Ignore coverage reports
coverage/
# Ignore IDE files
.idea/
.vscode/
# Ignore OS files
.DS_Store
Thumbs.db
# Ignore npm debug files
npm-debug.log*
# Ignore yarn debug files
yarn-debug.log*
yarn-error.log*
# Ignore lock files
package-lock.json
yarn.lock
# Ignore test output
test-output/
# Ignore temporary files
tmp/
temp/
